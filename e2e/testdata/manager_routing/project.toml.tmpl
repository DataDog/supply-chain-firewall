[tool.poetry]
name = "scfw-manager-routing"
version = "0.1.0"
package-mode = false
[tool.poetry.dependencies]
python = "=={{.Python}}"
"{{.Name}}" = {{if .URL}}{url = "{{.URL}}"}{{else}}"=={{.Version}}"{{end}}
